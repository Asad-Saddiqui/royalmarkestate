RewriteEngine On
# Redirect only browser requests for PHP pages; internal rewrites remain internal.
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/index\.php[?\s] [NC]
RewriteRule ^index\.php$ /Royalmarkestate/ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/properties\.php[?\s] [NC]
RewriteRule ^properties\.php$ /Royalmarkestate/property-listing [R=302,L]
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/projects\.php[?\s] [NC]
RewriteRule ^projects\.php$ /Royalmarkestate/projects [R=302,L]
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/contact\.php[?\s] [NC]
RewriteRule ^contact\.php$ /Royalmarkestate/contact-us [R=302,L]
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/about\.php[?\s] [NC]
RewriteRule ^about\.php$ /Royalmarkestate/about-us [R=302,L]
RewriteCond %{THE_REQUEST} \s/+Royalmarkestate/blog\.php[?\s] [NC]
RewriteRule ^blog\.php$ /Royalmarkestate/blog [R=302,L]
RewriteRule ^property-listing/?$ properties.php [END]
RewriteRule ^projects/?$ projects.php [END]
RewriteRule ^contact-us/?$ contact.php [END]
RewriteRule ^about-us/?$ about.php [END]
RewriteRule ^blog/?$ blog.php [END]
RewriteRule ^property-listing/([a-z0-9-]+)/?$ property.php?slug=$1 [END,QSA]