RewriteEngine On
# Separate user dashboard entry point.
RewriteRule ^user/?$ admin/user-dashboard.php [END]
# Legacy template login always opens the real login, under any install folder.
RewriteCond %{REQUEST_URI} ^(.*)/sign-in(?:\.html)?/?$ [NC]
RewriteRule ^sign-in(?:\.html)?/?$ %1/admin/login [R=302,L,NE]
# Redirect only browser requests for PHP pages; internal rewrites remain internal.
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?index\.php[?\s] [NC]
RewriteRule ^index\.php$ ./ [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?properties\.php[?\s] [NC]
RewriteRule ^properties\.php$ property-listing [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?projects\.php[?\s] [NC]
RewriteRule ^projects\.php$ projects [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?contact\.php[?\s] [NC]
RewriteRule ^contact\.php$ contact-us [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?about\.php[?\s] [NC]
RewriteRule ^about\.php$ about-us [R=302,L]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?blog\.php[?\s] [NC]
RewriteRule ^blog\.php$ blog [R=302,L]
RewriteRule ^property-listing/?$ properties.php [END]
RewriteRule ^projects/?$ projects.php [END]
RewriteRule ^agents/?$ agents.php [END]
RewriteRule ^project-listing/([a-z0-9-]+)/?$ project.php?slug=$1 [END,QSA]
RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]+/)?agents\.php[?\s] [NC]
RewriteRule ^agents\.php$ agents [R=302,L]
RewriteRule ^contact-us/?$ contact.php [END]
RewriteRule ^about-us/?$ about.php [END]
RewriteRule ^blog/?$ blog.php [END]
RewriteRule ^property-listing/([a-z0-9-]+)/?$ property.php?slug=$1 [END,QSA]

# Prevent downloading environment secrets.
<FilesMatch "^\.env(?:\..*)?$">
Require all denied
</FilesMatch>
