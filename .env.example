# Copy to .env and enter the database details for this environment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=royalmarkestate
DB_USERNAME=root
DB_PASSWORD=""

# SMTP for password reset emails; set password only in private .env
MAIL_HOST=mail.royalmarkestate.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=noreply@royalmarkestate.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@royalmarkestate.com
MAIL_FROM_NAME="Royalmark Estate"
APP_URL=https://royalmarkestate.com
