RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+[^?\s]*admin/(properties|projects|login|create-property|create-project|logout|users|catalog|settings|company|blog|forgot-password|reset-password|user-dashboard)\.php[?\s] [NC]
RewriteCond %{REQUEST_URI} ^(.*/admin)/(?:properties|projects|login|create-property|create-project|logout|users|catalog|settings|company|blog|forgot-password|reset-password|user-dashboard)\.php$
RewriteRule ^(properties|projects|login|create-property|create-project|logout|users|catalog|settings|company|blog|forgot-password|reset-password|user-dashboard)\.php$ %1/$1 [R=302,L]
RewriteRule ^(properties|projects|login|create-property|create-project|logout|users|catalog|settings|company|blog|forgot-password|reset-password|user-dashboard)/?$ $1.php [END]