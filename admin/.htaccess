RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+[^?\s]*admin/(properties|projects|login|create-property|logout)\.php[?\s] [NC]
RewriteCond %{REQUEST_URI} ^(.*/admin)/(?:properties|projects|login|create-property|logout)\.php$
RewriteRule ^(properties|projects|login|create-property|logout)\.php$ %1/$1 [R=302,L]
RewriteRule ^(properties|projects|login|create-property|logout)/?$ $1.php [END]