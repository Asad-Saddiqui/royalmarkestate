RewriteEngine On
RewriteCond %{THE_REQUEST} \s/+[^?\s]*admin/(properties|projects|login|create-property|logout|users|catalog|settings|company|blog|forgot-password|reset-password)\.php[?\s] [NC]
RewriteCond %{REQUEST_URI} ^(.*/admin)/(?:properties|projects|login|create-property|logout|users|catalog|settings|company|blog|forgot-password|reset-password)\.php$
RewriteRule ^(properties|projects|login|create-property|logout|users|catalog|settings|company|blog|forgot-password|reset-password)\.php$ %1/$1 [R=302,L]
RewriteRule ^(properties|projects|login|create-property|logout|users|catalog|settings|company|blog|forgot-password|reset-password)/?$ $1.php [END]